{
  "name": "langgraph-a2a-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "client": "tsx src/client-entry.ts",
    "dev": "tsx watch src/server-entry.ts",
    "doctor": "tsx src/doctor.ts",
    "env:init": "tsx scripts/init-env.ts",
    "start": "tsx src/server-entry.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@a2a-js/sdk": "^1.0.1",
    "@langchain/anthropic": "^1.5.4",
    "@langchain/core": "^1.2.5",
    "@langchain/langgraph": "^1.4.9",
    "@langchain/openai": "^1.5.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "tsx": "^4.23.9",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
