# Choose: openai/gpt, deepseek, anthropic/claude
MODEL_PROVIDER=openai
MODEL=gpt-4o-mini
API_KEY=replace-me

# Optional custom OpenAI-compatible or Anthropic endpoint.
# DeepSeek defaults to https://api.deepseek.com when this is empty.
BASE_URL=
MODEL_TEMPERATURE=0.2
# Optional positive integer. Empty uses the provider/model default.
MAX_TOKENS=
MODEL_TIMEOUT_MS=60000
MODEL_MAX_RETRIES=2

SERVER_HOST=127.0.0.1
SERVER_PORT=10000
# Set this when the public address differs from the bind address.
A2A_PUBLIC_URL=http://127.0.0.1:10000
A2A_SERVER_URL=http://127.0.0.1:10000
LOG_LEVEL=info

# SYSTEM_PROMPT=You are a helpful assistant exposed through the A2A protocol.
# CLIENT_SYSTEM_PROMPT=You are a client-side routing agent. Delegate substantive requests to the Server Agent.
