{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "A2A: Debug Server",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "node",
            "runtimeArgs": [
                "--import",
                "tsx"
            ],
            "program": "${workspaceFolder}/src/server-entry.ts",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
            "console": "integratedTerminal",
            "sourceMaps": true,
            "skipFiles": [
                "<node_internals>/**"
            ]
        },
        {
            "name": "A2A: Debug Client",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "node",
            "runtimeArgs": [
                "--import",
                "tsx"
            ],
            "program": "${workspaceFolder}/src/client-entry.ts",
            "preLaunchTask": "A2A: Wait for Server",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
            "console": "integratedTerminal",
            "sourceMaps": true,
            "skipFiles": [
                "<node_internals>/**"
            ]
        },
        {
            "name": "A2A: Debug Async Client",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "node",
            "runtimeArgs": [
                "--import",
                "tsx"
            ],
            "program": "${workspaceFolder}/src/client-async-entry.ts",
            "preLaunchTask": "A2A: Wait for Server",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
            "console": "integratedTerminal",
            "sourceMaps": true,
            "skipFiles": [
                "<node_internals>/**"
            ]
        }
    ],
    "compounds": [
        {
            "name": "A2A: Debug Client + Server",
            "configurations": [
                "A2A: Debug Server",
                "A2A: Debug Client"
            ],
            "stopAll": true
        },
        {
            "name": "A2A: Debug Async Client + Server",
            "configurations": [
                "A2A: Debug Server",
                "A2A: Debug Async Client"
            ],
            "stopAll": true
        }
    ]
}